# Command runner for Two Hours One Life Frontend

# Install tools and dependencies
bootstrap:
    mise install
    bun install

# Start development server
dev:
    bun run dev

# Build and prerender for production (SSG)
build:
    bun run generate

# Preview the production build locally
preview:
    bun run preview

# Update dependencies to their latest versions
update:
    bun update --latest
    bun run generate

# Clean build artifacts and dependencies
clean:
    rm -rf .nuxt .output node_modules
